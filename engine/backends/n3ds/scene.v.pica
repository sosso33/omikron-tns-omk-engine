; SPDX-License-Identifier: GPL-3.0-or-later
; THE 3DS SCENE VERTEX SHADER (`c3drender.cpp`, `todo/3ds-port.md` 3b).
;
; The GPU does the per-vertex work the CPU did in the first light - the GLES
; backend's `kSceneVert` (`backends/gles/glesrender.cpp`), law for law:
;
;   * the position through `mvp`, built on the CPU from `cameraBasis` - the
;     software rasterizer's own basis. Its depth row puts the PICA's near clip
;     plane (z <= 0) at the engine's near cut (w >= kNearCut), so the
;     hardware clipper makes the reference's cut; w is the view depth;
;   * the SHIMMER (mesh flag 0x8000000, `o3de/shimmer.h`): the 32-entry wave
;     at ((int(clock) >> 2) + int(phase)) & 31, added to all three channels;
;     a phase below zero does not shimmer;
;   * the FOG, linear on the view depth, toward BLACK (the shipped fog's
;     colour, `renderer.h`): the colour scaled by
;     clamp((end - w) / (end - start), 0, 1), the bucket key's exclusions
;     chosen on the CPU per draw (`fogp.z` 0 = none);
;   * the texture coordinates from texels by the bound texture's size.
;
; The PICA converts an unsigned-byte attribute to 0..255 WITHOUT normalising,
; so the colour is scaled back to 0..1 here.

; uniforms
.fvec mvp[4]          ; the rows of the view-projection
.fvec texscale        ; x = 1 / width, y = 1 / height
.fvec fogp            ; x = end, y = 1 / (end - start), z = 1 to fog, 0 not
.fvec shim            ; x = floor(floor(clock) / 4)
.fvec wave[32]        ; x = kShimmerWave[i] / 255

.constf k(0.0039215686, 1.0, 0.03125, 32.0)
.constf z0(0.0, 0.0, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inuv  v1
.alias inclr v2
.alias inph  v3

.proc main
	; constants into temporaries (an instruction's second source cannot be one)
	mov r10, z0
	mov r11, k

	; the position
	mov r0.xyz, inpos
	mov r0.w, r11.y
	dp4 r1.x, mvp[0], r0
	dp4 r1.y, mvp[1], r0
	dp4 r1.z, mvp[2], r0
	dp4 r1.w, mvp[3], r0
	mov outpos, r1

	; the texture coordinates
	mul r2.xy, texscale.xy, inuv.xy
	mov outtc0, r2

	; the shimmer: idx = (shim + floor(phase)) mod 32, the wave there, kept
	; only where phase >= 0
	flr r3.x, inph.x
	add r3.x, shim.x, r3.x
	mul r4.x, r11.z, r3.x
	flr r4.x, r4.x
	mul r4.x, r11.w, r4.x
	add r3.x, r3.x, -r4.x
	mova a0.x, r3.x
	mov r5, wave[a0.x]
	sge r6.x, inph.x, r10.x
	mul r5.x, r5.x, r6.x

	; the colour, the shimmer added
	mul r7, k.xxxx, inclr
	add r7.xyz, r7.xyz, r5.xxx

	; the fog: f = 1 + on * (clamp((end - w) / (end - start), 0, 1) - 1)
	add r8.x, fogp.x, -r1.w
	mul r8.x, fogp.y, r8.x
	max r8.x, r8.x, r10.x
	min r8.x, r8.x, r11.y
	add r8.x, r8.x, -r11.y
	mul r8.x, fogp.z, r8.x
	add r8.x, r11.y, r8.x
	mul r7.xyz, r7.xyz, r8.xxx
	mov r7.w, r11.y
	mov outclr, r7
	end
.end
